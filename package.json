{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun --bun nuxt build",
    "dev": "bun --bun nuxt dev",
    "generate": "bun --bun nuxt generate",
    "preview": "bun --bun nuxt preview",
    "postinstall": "bun --bun nuxt prepare",
    "test": "bun run test:unit",
    "lint": "oxlint . && eslint --ext .js,.ts,.vue .",
    "format": "oxfmt --write .",
    "test:unit": "bun --bun vitest run --config=vitest.config.ts",
    "test:integration": "bun --bun vitest run --config=vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:cleanup": "bun server/lib/cleanup.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.131",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.2",
    "@nuxt/ui": "4.11.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.102.8",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.10.0",
    "h3": "^1.15.11",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.12",
    "nuxt": "^4.5.2",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unique-names-generator": "^4.7.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "vitest": "^5.0.0"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild",
    "unrs-resolver",
    "vue-demi"
  ]
}
