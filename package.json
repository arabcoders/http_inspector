{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun --bun nuxt build",
    "dev": "bun --bun nuxt dev",
    "generate": "bun --bun nuxt generate",
    "preview": "bun --bun nuxt preview",
    "postinstall": "bun --bun nuxt prepare",
    "test": "bun --bun vitest run",
    "typecheck": "bun --bun nuxt typecheck",
    "lint": "oxlint . && eslint --ext .js,.ts,.vue .",
    "format": "oxfmt --write .",
    "test:unit": "bun --bun vitest run test/unit",
    "test:integration": "bun --bun vitest run test/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:cleanup": "bun server/lib/cleanup.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.156",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/ui": "4.13.0",
    "@tanstack/vue-query": "^5.108.0",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.15.0",
    "h3": "^1.15.11",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.2.1",
    "nuxt": "^4.6.4",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "unique-names-generator": "^4.7.1",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "defu": "6.1.7",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.20",
    "postcss": "8.5.33",
    "source-map-js": "1.2.2",
    "tar": "7.5.23"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild",
    "unrs-resolver",
    "vue-demi"
  ]
}
